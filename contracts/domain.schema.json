{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "领域资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "facts",
    "entities",
    "rules",
    "sample"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "project",
        "inquiries",
        "configurations",
        "quotes",
        "design_versions",
        "adaptation_versions",
        "part_sources",
        "certificates",
        "modules",
        "capacity_locks",
        "boxes",
        "shipments",
        "customs_documents",
        "handovers",
        "acceptances",
        "customer_view"
      ]
    }
  },
  "additionalProperties": false
}
